; REQUIRES: cocoa
; EXPECT: sat
; COMMAND-LINE: --ff-solver=gb
; koszul torus maps over F_7: (α,α_q2,σ)=(2,3,1), ξ=σ², roundtrip=Ψ₆
(set-info :smt-lib-version 2.6)
(set-info :category "crafted")
(set-logic QF_FF)
(define-sort F () (_ FiniteField 7))
(declare-fun alpha () F)
(declare-fun alpha_q2 () F)
(declare-fun xi () F)
(declare-fun sigma () F)
(declare-fun beta () F)
(declare-fun round () F)
(declare-fun t1 () F)
(declare-fun t2 () F)
(assert (= alpha (as ff2 F)))
(assert (= alpha_q2 (as ff3 F)))
(assert (= sigma (as ff1 F)))
(assert (= xi (ff.mul sigma sigma)))
(assert (= (ff.mul beta (ff.add alpha (ff.neg alpha_q2)))
           (ff.add xi (ff.neg (ff.mul alpha alpha_q2)))))
(assert (= (ff.mul round (ff.add beta sigma))
           (ff.add beta (ff.neg sigma))))
(assert (= (ff.mul t1 (ff.add alpha sigma))
           (ff.add alpha (ff.neg sigma))))
(assert (= (ff.mul t2 (ff.add alpha_q2 (ff.neg sigma)))
           (ff.add alpha_q2 sigma)))
(assert (= round (ff.mul t1 t2)))
(check-sat)
