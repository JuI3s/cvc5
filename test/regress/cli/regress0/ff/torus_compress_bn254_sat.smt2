; REQUIRES: cocoa
; EXPECT: sat
; COMMAND-LINE: --ff-solver=gb
; koszul generated_bn254_roundtrip_matches_psi6, first seed-254 case
(set-info :smt-lib-version 2.6)
(set-info :category "crafted")
(set-logic QF_FF)
(define-sort F () (_ FiniteField 21888242871839275222246405745257275088696311157297823662689037894645226208583))
(declare-fun alpha () F)
(declare-fun alpha_q2 () F)
(declare-fun xi () F)
(declare-fun sigma () F)
(declare-fun beta () F)
(declare-fun round () F)
(declare-fun want () F)
(assert (= alpha (as ff102609778554328592397527562638165191498889243573332421315415941909295866757 F)))
(assert (= alpha_q2 (as ff19564348623480119536906598307487181858459313304086936071243423861356656796517 F)))
(assert (= xi (as ff11137621600676182283978083904193451706558564978606998894633192088899667176955 F)))
(assert (= sigma (as ff6152101684134222499223039114266903464795143687588070972949203925481563922265 F)))
(assert (= beta (as ff13184506276696272187367792069359276075082597614419028905153664269425711986288 F)))
(assert (= want (as ff786820565028635888185405204634005267115365832515932898232224026758678753208 F)))
(assert (= (ff.mul sigma sigma) xi))
(assert (= (ff.mul beta (ff.add alpha (ff.neg alpha_q2)))
           (ff.add xi (ff.neg (ff.mul alpha alpha_q2)))))
(assert (= (ff.mul round (ff.add beta sigma))
           (ff.add beta (ff.neg sigma))))
(declare-fun t1 () F)
(declare-fun t2 () F)
(assert (= (ff.mul t1 (ff.add alpha sigma))
           (ff.add alpha (ff.neg sigma))))
(assert (= (ff.mul t2 (ff.add alpha_q2 (ff.neg sigma)))
           (ff.add alpha_q2 sigma)))
(assert (= round want))
(assert (= want (ff.mul t1 t2)))
(check-sat)
