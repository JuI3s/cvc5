; REQUIRES: cocoa
; EXPECT: unsat
; COMMAND-LINE: --ff-solver=gb --ff-field-polys
; COMMAND-LINE: --ff-solver=gb
; koszul torus: decompress(compress(α))=Ψ₆ on ⟨σ²-ξ⟩ off poles
(set-info :smt-lib-version 2.6)
(set-info :category "crafted")
(set-logic QF_FF)
(define-sort F () (_ FiniteField 17))
(declare-fun alpha () F)
(declare-fun alpha_q2 () F)
(declare-fun xi () F)
(declare-fun sigma () F)
(declare-fun beta () F)
(declare-fun round () F)
(declare-fun t1 () F)
(declare-fun t2 () F)
(assert (= (ff.mul sigma sigma) xi))
(assert (not (= alpha alpha_q2)))
(assert (not (= (ff.add alpha sigma) (as ff0 F))))
(assert (not (= (ff.add alpha_q2 (ff.neg sigma)) (as ff0 F))))
(assert (= (ff.mul beta (ff.add alpha (ff.neg alpha_q2)))
           (ff.add xi (ff.neg (ff.mul alpha alpha_q2)))))
(assert (not (= (ff.add beta sigma) (as ff0 F))))
(assert (= (ff.mul round (ff.add beta sigma))
           (ff.add beta (ff.neg sigma))))
(assert (= (ff.mul t1 (ff.add alpha sigma))
           (ff.add alpha (ff.neg sigma))))
(assert (= (ff.mul t2 (ff.add alpha_q2 (ff.neg sigma)))
           (ff.add alpha_q2 sigma)))
(assert (not (= round (ff.mul t1 t2))))
(check-sat)
