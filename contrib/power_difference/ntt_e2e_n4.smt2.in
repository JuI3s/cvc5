; GENERATED by contrib/power_difference/generate_ntt_e2e.py.
; Edit contrib/power_difference/ntt_e2e_n4.smt2.in or
; contrib/power_difference/ntt_e2e_n4.json, then regenerate.
; REQUIRES: cocoa
$expectations

; Literal port of the size-4 identities in koszul/examples/ntt.py.
; Every coefficient is free. The only generator is psi^4+1.
(set-option :incremental true)
(set-logic QF_FF)
(define-sort F () (_ FiniteField $modulus))

(declare-fun psi () F)
(declare-fun f0 () F)
(declare-fun f1 () F)
(declare-fun f2 () F)
(declare-fun f3 () F)
(declare-fun g0 () F)
(declare-fun g1 () F)
(declare-fun g2 () F)
(declare-fun g3 () F)

(define-fun psi2 () F ((_ ff.pow 2) psi))
(define-fun psi3 () F ((_ ff.pow 3) psi))
(define-fun psi4 () F ((_ ff.pow 4) psi))
(define-fun psi5 () F ((_ ff.pow 5) psi))
(define-fun psi6 () F ((_ ff.pow 6) psi))
(define-fun psi7 () F ((_ ff.pow 7) psi))

; NTT(x)_k = sum_j x_j psi^(j(2k+1)). Exponents are represented modulo 8
; because psi^4=-1 implies psi^8=1.
(define-fun ntt0 ((x0 F) (x1 F) (x2 F) (x3 F)) F
  (ff.add x0 (ff.mul x1 psi) (ff.mul x2 psi2) (ff.mul x3 psi3)))
(define-fun ntt1 ((x0 F) (x1 F) (x2 F) (x3 F)) F
  (ff.add x0 (ff.mul x1 psi3) (ff.mul x2 psi6) (ff.mul x3 psi)))
(define-fun ntt2 ((x0 F) (x1 F) (x2 F) (x3 F)) F
  (ff.add x0 (ff.mul x1 psi5) (ff.mul x2 psi2) (ff.mul x3 psi7)))
(define-fun ntt3 ((x0 F) (x1 F) (x2 F) (x3 F)) F
  (ff.add x0 (ff.mul x1 psi7) (ff.mul x2 psi6) (ff.mul x3 psi5)))

(define-fun f-ntt0 () F (ntt0 f0 f1 f2 f3))
(define-fun f-ntt1 () F (ntt1 f0 f1 f2 f3))
(define-fun f-ntt2 () F (ntt2 f0 f1 f2 f3))
(define-fun f-ntt3 () F (ntt3 f0 f1 f2 f3))
(define-fun g-ntt0 () F (ntt0 g0 g1 g2 g3))
(define-fun g-ntt1 () F (ntt1 g0 g1 g2 g3))
(define-fun g-ntt2 () F (ntt2 g0 g1 g2 g3))
(define-fun g-ntt3 () F (ntt3 g0 g1 g2 g3))

; INTT(x)_k = 4^(-1) sum_i x_i psi^(-k(2i+1)).
(define-fun intt0 ((x0 F) (x1 F) (x2 F) (x3 F)) F
  (ff.mul (as ff$transform_size_inverse F) (ff.add x0 x1 x2 x3)))
(define-fun intt1 ((x0 F) (x1 F) (x2 F) (x3 F)) F
  (ff.mul
    (as ff$transform_size_inverse F)
    (ff.add
      (ff.mul x0 psi7)
      (ff.mul x1 psi5)
      (ff.mul x2 psi3)
      (ff.mul x3 psi))))
(define-fun intt2 ((x0 F) (x1 F) (x2 F) (x3 F)) F
  (ff.mul
    (as ff$transform_size_inverse F)
    (ff.add
      (ff.mul x0 psi6)
      (ff.mul x1 psi2)
      (ff.mul x2 psi6)
      (ff.mul x3 psi2))))
(define-fun intt3 ((x0 F) (x1 F) (x2 F) (x3 F)) F
  (ff.mul
    (as ff$transform_size_inverse F)
    (ff.add
      (ff.mul x0 psi5)
      (ff.mul x1 psi7)
      (ff.mul x2 psi)
      (ff.mul x3 psi3))))

; Product coefficients in F_$modulus[X]/(X^4+1).
(define-fun h0 () F
  (ff.add
    (ff.mul f0 g0)
    (ff.neg (ff.mul f1 g3))
    (ff.neg (ff.mul f2 g2))
    (ff.neg (ff.mul f3 g1))))
(define-fun h1 () F
  (ff.add
    (ff.mul f0 g1)
    (ff.mul f1 g0)
    (ff.neg (ff.mul f2 g3))
    (ff.neg (ff.mul f3 g2))))
(define-fun h2 () F
  (ff.add
    (ff.mul f0 g2)
    (ff.mul f1 g1)
    (ff.mul f2 g0)
    (ff.neg (ff.mul f3 g3))))
(define-fun h3 () F
  (ff.add
    (ff.mul f0 g3)
    (ff.mul f1 g2)
    (ff.mul f2 g1)
    (ff.mul f3 g0)))

; One radix-2 Cooley--Tukey layer over the two size-2 transforms.
(define-fun even0 () F (ff.add f0 (ff.mul f2 psi2)))
(define-fun even1 () F (ff.add f0 (ff.mul f2 psi6)))
(define-fun odd0 () F (ff.add f1 (ff.mul f3 psi2)))
(define-fun odd1 () F (ff.add f1 (ff.mul f3 psi6)))
(define-fun ct0 () F (ff.add even0 (ff.mul psi odd0)))
(define-fun ct1 () F (ff.add even1 (ff.mul psi3 odd1)))
(define-fun ct2 () F (ff.add even0 (ff.neg (ff.mul psi odd0))))
(define-fun ct3 () F (ff.add even1 (ff.neg (ff.mul psi3 odd1))))

(assert (= psi4 (ff.neg (as ff1 F))))

; INTT(NTT(f)) = f.
(check-ideal-membership
  (= (intt0 f-ntt0 f-ntt1 f-ntt2 f-ntt3) f0))
(check-sat)
(check-ideal-membership
  (= (intt1 f-ntt0 f-ntt1 f-ntt2 f-ntt3) f1))
(check-sat)
(check-ideal-membership
  (= (intt2 f-ntt0 f-ntt1 f-ntt2 f-ntt3) f2))
(check-sat)
(check-ideal-membership
  (= (intt3 f-ntt0 f-ntt1 f-ntt2 f-ntt3) f3))
(check-sat)

; NTT(f*g) = NTT(f) pointwise NTT(g).
(check-ideal-membership
  (= (ntt0 h0 h1 h2 h3) (ff.mul f-ntt0 g-ntt0)))
(check-sat)
(check-ideal-membership
  (= (ntt1 h0 h1 h2 h3) (ff.mul f-ntt1 g-ntt1)))
(check-sat)
(check-ideal-membership
  (= (ntt2 h0 h1 h2 h3) (ff.mul f-ntt2 g-ntt2)))
(check-sat)
(check-ideal-membership
  (= (ntt3 h0 h1 h2 h3) (ff.mul f-ntt3 g-ntt3)))
(check-sat)

; The radix-2 Cooley--Tukey implementation equals the direct specification.
(check-ideal-membership (= ct0 f-ntt0))
(check-sat)
(check-ideal-membership (= ct1 f-ntt1))
(check-sat)
(check-ideal-membership (= ct2 f-ntt2))
(check-sat)
(check-ideal-membership (= ct3 f-ntt3))
(check-sat)
